<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_valley"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c1"
        style="@style/clearing"
        android:background="@drawable/clearing_1"
        app:layout_constraintBottom_toTopOf="@id/c2"
        app:layout_constraintEnd_toStartOf="@id/c4"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c4"
        style="@style/clearing"
        android:background="@drawable/clearing_4_vector"
        app:layout_constraintBottom_toTopOf="@id/c5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/c1"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c2"
        style="@style/clearing"
        android:background="@drawable/clearing_2_vector"
        app:layout_constraintEnd_toStartOf="@id/c5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c1"
        app:layout_constraintBottom_toTopOf="@id/c3" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c5"
        style="@style/clearing"
        android:background="@drawable/clearing_5_vector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/c2"
        app:layout_constraintTop_toBottomOf="@id/c4"
        app:layout_constraintBottom_toTopOf="@id/c6"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c3"
        style="@style/clearing"
        android:background="@drawable/clearing_3_vector"
        app:layout_constraintEnd_toStartOf="@id/c6"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/c2"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c6"
        style="@style/clearing"
        android:background="@drawable/clearing_6_vector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/c3"
        app:layout_constraintTop_toBottomOf="@id/c5"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>