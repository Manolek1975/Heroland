<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_valley"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="150dp"
    android:layout_marginBottom="150dp"
    android:background="@color/transparent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c2"
        style="@style/clearing"
        android:layout_gravity="top|center"
        android:background="@drawable/clearing_2" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c5"
        style="@style/clearing"
        android:layout_gravity="bottom|center"
        android:background="@drawable/clearing_5" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c1"
        style="@style/clearing"
        android:layout_gravity="center|start"
        android:background="@drawable/clearing_1" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/c4"
        style="@style/clearing"
        android:layout_gravity="center|end"
        android:background="@drawable/clearing_4" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dwelling"
        style="@style/clearing"
        android:layout_gravity="bottom|center"
        tools:background="@drawable/d_inn" />


</FrameLayout>