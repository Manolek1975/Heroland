<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Heroland" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar color. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowTranslucentStatus">true</item>
        <!-- Customize your light theme here. -->
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/macondo</item>
    </style>

    <style name="Theme.Heroland" parent="Base.Theme.Heroland" />

    <style name="head" parent="Theme.Heroland">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">36dp</item>
        <item name="android:text">HEADER</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="arrow_back" parent="Base.Theme.Heroland">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_margin">25dp</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:background">@drawable/arrow_back</item>
        <item name="android:contentDescription">@string/back</item>
    </style>

    <style name="AppTheme.AlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/layout_dialog</item>
        <!-- Used for the buttons -->
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="android:colorAccent">@color/yellow</item>
        <item name="android:textColor">@color/white</item>
        <!-- Used for the title and text -->
        <item name="android:textAppearanceSmall">@style/TextAppearanceSmall</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textSize">20sp</item>
        <!-- Used for the background -->
        <item name="android:background">@color/primary</item>
    </style>

    <style name="TextAppearanceSmall" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/macondo</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:width">90dp</item>
        <item name="android:padding">0px</item>
    </style>

    <style name="Base.Theme.Chit" parent="Base.Theme.Heroland">
        <item name="android:layout_width">wrap_content</item>"
        <item name="android:layout_height">wrap_content</item>"
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Base.Theme.Chit.Layout" parent="Base.Theme.Heroland">
        <item name="android:background">@drawable/layout_square</item>
    </style>

    <style name="Base.Theme.Type.Layout" parent="Base.Theme.Heroland">
        <item name="android:background">@drawable/layout_square</item>
    </style>

    <style name="Base.Theme.Spell" parent="Base.Theme.Heroland">
        <item name="android:layout_width">wrap_content</item>"
        <item name="android:layout_height">wrap_content</item>"
        <item name="android:layout_gravity">center</item>">
        <item name="android:gravity">center</item>">
        <item name="android:fontFamily">@android/sans-serif</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Base.Theme.Advice.Layout" parent="Base.Theme.Heroland">
        <item name="android:background">@drawable/layout_advice</item>
        <item name="android:layout_width">wrap_content</item>"
        <item name="android:layout_height">wrap_content</item>"
        <item name="android:layout_gravity">top|end</item>">
        <item name="android:gravity">center</item>">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="box_cell" parent="Base.Theme.Heroland">
        <item name="android:background">@drawable/layout_box</item>
        <item name="android:layout_gravity">center</item>">
        <item name="android:gravity">center</item>">
        <item name="android:layout_width">wrap_content</item>"
        <item name="android:layout_height">wrap_content</item>"
    </style>

    <style name="native_text" parent="Base.Theme.Heroland">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Group.Style" parent="Base.Theme.Heroland">
        <item name="android:background">@drawable/layout_group_selected</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/macondo</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="clearing" parent="Base.Theme.Heroland">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">40dp</item>
        <item name="android:padding">24dp</item>
        <item name="android:text">@string/clearing</item>
        <item name="android:contentDescription">@string/clearing</item>
    </style>

    <style name="dice" parent="Base.Theme.Heroland">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">60dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:visibility">gone</item>

    </style>


</resources>